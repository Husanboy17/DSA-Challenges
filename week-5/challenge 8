class Node:
    def __init__(self, val):
        self.val = val
        self.left = None
        self.right = None

# Function to check if the tree is a valid BST
def is_valid_bst(root):

    # Duplicate values are not allowed in this BST
    def check(node, low, high):

        # An empty tree/subtree is valid
        if node is None:
            return True

        # The current node must be inside the allowed range
        if node.val <= low or node.val >= high:
            return False

        # Check the left and right subtrees
        left_valid = check(node.left, low, node.val)
        right_valid = check(node.right, node.val, high)

        return left_valid and right_valid

    # Start with no lower or upper limit
    return check(root, float('-inf'), float('inf'))

root1 = Node(5)

root1.left = Node(2)
root1.right = Node(8)

root1.left.left = Node(1)
root1.left.right = Node(3)

root1.right.left = Node(6)
root1.right.right = Node(9)

print("Test 1:", is_valid_bst(root1))

root2 = Node(5)

root2.left = Node(1)
root2.right = Node(8)

root2.right.left = Node(4)
root2.right.right = Node(9)
print("Test 2:", is_valid_bst(root2))
