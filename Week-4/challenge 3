class Node:
    def __init__(self, value):
        self.value = value
        self.next = None

def reverse_list(head):
    prev = None
    curr = head

    while curr is not None:
        next_node = curr.next

        # Reverse the link
        curr.next = prev

        # Move forward
        prev = curr
        curr = next_node

    return prev

def print_list(head):
    curr = head

    while curr is not None:
        print(curr.value, end=" -> ")
        curr = curr.next

    print("None")

node1 = Node(1)
node2 = Node(2)
node3 = Node(3)

node1.next = node2
node2.next = node3

head = node1

print("Before:")
print_list(head)

head = reverse_list(head)

print("After:")
print_list(head)
