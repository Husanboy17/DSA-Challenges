def is_balanced(s: str) -> bool:
    stack = []

    pairs = {
        ')': '(',
        ']': '[',
        '}': '{'
    }

    for char in s:

        # Opening bracket
        if char in "([{":
            stack.append(char)

        # Closing bracket
        elif char in ")]}":

            if not stack:
                return False

            top = stack.pop()

            # Brackets do not match
            if top != pairs[char]:
                return False

    return len(stack) == 0


# Tests
print(is_balanced("(a[b]{c})"))   # True
print(is_balanced("([)]"))        # False
