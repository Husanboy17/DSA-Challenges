class QueueFromStacks:
    def __init__(self):
        self.in_stack = []
        self.out_stack = []

    def enqueue(self, x):
        # New elements always will be added to in_stack
        self.in_stack.append(x)

    def dequeue(self):
        # If out_stack is empty, elements inside the in_stack will move to out_stack,
        if not self.out_stack:
            while self.in_stack:
                self.out_stack.append(self.in_stack.pop())

        # if both stack empty
        if not self.out_stack:
            raise IndexError("Queue is empty")

        # deleting first enetered element
        return self.out_stack.pop()

queue = QueueFromStacks()

queue.enqueue(1)
queue.enqueue(2)
queue.enqueue(3)

print(queue.dequeue())
print(queue.dequeue())
print(queue.dequeue())
